# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development            # development | production
SECRET_KEY=                    # REQUIRED in production: python -c "import secrets;print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///rusworldcourier.db   # production: postgresql://user:pass@host:5432/dbname
SITE_URL=http://127.0.0.1:5000 # public https URL in production (used in emails, canonical URLs, Paystack callback)
TRUSTED_PROXY_HOPS=0           # set to 1 behind nginx / Render / Fly / Heroku so client IPs (rate limits, audit log) are right
RATELIMIT_STORAGE_URI=memory://  # production with >1 worker: redis://host:6379/0

# Company details shown on the site (leave blank until you have real ones - the site says "not configured")
COMPANY_NAME=RusWorld Courier
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_HOURS=Mon-Fri 09:00-18:00 (Moscow time)
COMPANY_REG_NO=

# Pricing (rates live in rwc/tariff.py - EXAMPLE tariff, replace with your real one)
CURRENCY=USD                   # must be a currency enabled on your Paystack account (NGN, GHS, ZAR, KES, USD ...)
FUEL_SURCHARGE_PCT=8
REQUIRE_PAYMENT_BEFORE_PICKUP=true

# Paystack - shipping fee paid by the SENDER at booking. Use sk_test_ keys until you go live.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Webhook URL to set in the Paystack dashboard:  {SITE_URL}/webhooks/paystack   (signature = HMAC-SHA512 of body with the secret key)

# Email (SMTP). Without these, emails are NOT sent - they are recorded as "not_sent" in Staff > Outbox and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls         # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS (Twilio, optional, only sent to customers who opted in). Without these SMS is recorded as "not_sent".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# For non-interactive admin creation: flask --app app create-admin
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
